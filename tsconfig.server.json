{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist/server",
    "types": ["node"]
  },
  // "scripts" is included so the standalone utilities under it are actually
  // type-checked. They were not covered by any tsconfig before Task W, which
  // meant a tool an operator runs by hand — and which deletes data — was the
  // one file in the repository the compiler never looked at.
  "include": ["server", "shared", "scripts"]
}

