# Placeholders only — no real values belong in this file (it is committed to git).
# Copy to `.env` for local development; `.env` is git-ignored.
#
# Server variables are read directly from process.env. tsx (used by `npm run
# dev:server`) does not auto-load `.env` files (verified: its README has no
# mention of env-file handling). Node >=20.6 supports the native
# `--env-file=.env` / `--env-file-if-exists=.env` flags if you want a local
# `.env` picked up automatically when running server code directly, e.g.:
#   node --env-file-if-exists=.env --import tsx server/index.ts
# No npm script currently wires this in; supply these variables via your
# shell environment, a process manager, or the flag above.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Service-role key — server/worker-only (ingestion writes to shared
# discovery data: vacancies, sources, etc.). Bypasses RLS. Never prefix
# this with VITE_ (that would expose it to the browser bundle) and never
# import server/supabaseServiceRole.ts from client/src.
SUPABASE_SERVICE_ROLE_KEY=

# R2 ingestion provider credentials — server/worker-only. Greenhouse and
# Lever discovery need no credentials at all (public GET endpoints).
# USAJOBS User-Agent must be the email address registered for the key, not
# a browser string. Not configured yet — no real values available this
# pass; the ingestion worker fails clearly rather than guessing if these
# are required but unset.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble REST API — server/worker-only. Unlike every other credential above,
# the key for THIS provider travels in the request URL PATH
# (POST https://jooble.org/api/{JOOBLE_API_KEY}), not in a header, so it leaks
# through anything that records a URL: logs, error messages, APM/Sentry spans,
# n8n execution data. Never log it and never paste it into a URL you print —
# use REDACTED_JOOBLE_ENDPOINT from server/ingestion/adapters/jooble.ts.
#
# Two provider facts that make this key different from the others:
#   1. It is COUNTRY-SCOPED. Each Jooble domain issues its own key and returns
#      only that country's listings (jooble.org => US, uk.jooble.org => UK).
#      A key used against the wrong domain returns HTTP 403, not empty results.
#   2. The free plan is a LIFETIME quota of 500 requests per key (not monthly).
#      A retry or a pagination step spends it. Keep a separate key for local
#      development if the portal allows it, so testing cannot consume the
#      production allowance.
# Register at https://jooble.org/api/about (or your target country's domain).
JOOBLE_API_KEY=your_key_here

# The Muse and SerpApi are OPT-IN on the on-demand intake path. Both flags are
# fail-closed: only the exact string "true" enables the source — unset, empty,
# "1", "yes" and "TRUE" all leave it off, so a deployment typo cannot silently
# start spending a third party's quota.
#
# The Muse needs the flag only; its api_key is optional and raises the rate
# limit from 500 to 3,600 requests per hour.
THE_MUSE_INTAKE_ENABLED=
THE_MUSE_API_KEY=

# SerpApi needs the flag AND the key, unlike The Muse, and the budget is why:
# 100 searches per MONTH on the free tier, the tightest in the fan-out by two
# orders of magnitude. A flag alone would let an operator enable the source on a
# deployment with no credential, so every candidate click would report a skipped
# source (server/intake/adapters/registry.ts).
SERPAPI_INTAKE_ENABLED=
SERPAPI_API_KEY=

# Legacy single-employer fallback for the Greenhouse submission adapter
# (server/applications/adapters/greenhouse.ts). The supported path is the admin
# ATS Credentials screen, which stores one encrypted key per employer in
# ats_credentials — a single environment variable can only ever serve ONE
# employer, which is exactly why that table replaced this variable. Leave unset
# in production unless you are deliberately exercising that adapter directly.
GREENHOUSE_API_KEY=

# MP-F1 resume fact extraction — server-only, via OpenRouter (OpenAI-SDK
# compatible baseURL). Never prefix with VITE_ and never import
# server/resumes/openaiClient.ts from client/src.
OPENROUTER_API_KEY=
# Optional — defaults to DEFAULT_OPENAI_MODEL in server/resumes/openaiExtraction.ts when unset.
OPENROUTER_MODEL=

# MP-W2 — server-only. Shared secret an external scheduler (cron) presents
# as `Authorization: Bearer <value>` to POST /api/worker/run, which triggers
# the MP-W1 batch entrypoint over HTTP. Deliberately separate from
# SUPABASE_SERVICE_ROLE_KEY — see server/requireWorkerSecret.ts for why.
# Unset means the route responds 500 (unreachable), not open.
WORKER_TRIGGER_SECRET=

# Task D — the autonomous scheduler daemon (npm run scheduler locally;
# "node dist/server/server/scheduler.js" in production, where the runtime image
# has no tsx and no server/ source). Every variable below is OPTIONAL; the
# defaults are the values in server/schedulerTasks.ts.
#
# SCHEDULER_DISABLED_TASKS IS AN OFF-LIST, NOT AN ON-LIST. The scheduler builds
# every task it can and then removes the names listed here, so a typo disables
# nothing (unknown names are ignored, not rejected) and the startup log prints
# exactly which tasks are live. Task names:
#   fit-analysis, ranking-refresh, anti-ghosting, mailbox-poll,
#   mailbox-classify, mailbox-match, calendar-sync, discovery
#
# READ THIS BEFORE STARTING THE SCHEDULER ANYWHERE. Left unset, it starts
# fit-analysis (every 5m), anti-ghosting (every 24h) and mailbox-classify (every
# 5m) — and ALL THREE CALL THE PAID MODEL ENDPOINT — plus discovery (every 6h),
# which reaches third-party job APIs. A deployment that wants only the DB-only
# ranking refresh must say so explicitly, e.g.
#   SCHEDULER_DISABLED_TASKS=fit-analysis,anti-ghosting,mailbox-poll,mailbox-classify,mailbox-match,calendar-sync,discovery
SCHEDULER_DISABLED_TASKS=
#
# OPENROUTER_API_KEY IS MANDATORY TO START THE SCHEDULER, even when every
# model-backed task is disabled above. server/scheduler.ts constructs the OpenAI
# client BEFORE it filters the task list, so a missing key logs "[scheduler]
# cannot start: Missing OpenRouter configuration..." and exits with code 0.
# Under a supervisor configured with restart: unless-stopped that is a silent
# restart loop that never does any work — the log line is the only signal, which
# is why the exit code is 0 (see the note in server/scheduler.ts).
#
# Intervals are delays AFTER a run COMPLETES, not cron expressions, and are
# floored at 1s. An absent, unparseable or negative value falls back to the
# default rather than crashing or busy-looping (server/config/envInt.ts).
SCHEDULER_FIT_INTERVAL_MS=
SCHEDULER_RANKING_REFRESH_INTERVAL_MS=
SCHEDULER_ANTI_GHOSTING_INTERVAL_MS=
SCHEDULER_DISCOVERY_INTERVAL_MS=
SCHEDULER_MAILBOX_POLL_INTERVAL_MS=
SCHEDULER_MAILBOX_CLASSIFY_INTERVAL_MS=
SCHEDULER_MAILBOX_MATCH_INTERVAL_MS=
SCHEDULER_CALENDAR_SYNC_INTERVAL_MS=
# Backoff after a FAILED run, so a down database or model is not hammered.
SCHEDULER_ERROR_RETRY_MS=
#
# Batch C budgets, PER TICK. A tick stops at the candidate cap OR the tick
# deadline, whichever comes first, and the remainder waits for the next tick —
# so a schedule can never become one unbounded run. The per-candidate deadline
# is also the budget for the SHARED posting-evidence index, which is why a cold
# corpus completes over many ticks rather than in one.
SCHEDULER_REFRESH_MAX_CANDIDATES_PER_TICK=
SCHEDULER_REFRESH_PER_CANDIDATE_DEADLINE_MS=
SCHEDULER_REFRESH_TICK_DEADLINE_MS=

# R6.1 Gmail mailbox connect — server-only. From the Google Cloud Console
# OAuth client (Web application type). GOOGLE_OAUTH_REDIRECT_URI must
# exactly match a Authorized redirect URI registered there, e.g.
# https://<your-domain>/api/mailbox/oauth/callback (or
# http://127.0.0.1:5000/api/mailbox/oauth/callback for local dev). Not
# configured yet — see server/mailbox/oauth.ts.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# R6.1 — server-only. 32 random bytes, base64-encoded (e.g. `openssl rand
# -base64 32`). Encrypts the Gmail OAuth token bundle at rest before it's
# stored in mailbox_connections.secret_manager_key — see
# server/mailbox/tokenCrypto.ts for why this exists instead of a real
# secret-manager service.
MAILBOX_TOKEN_ENCRYPTION_KEY=

# R6.1 — server-only. Any random string; signs the OAuth `state` param so
# GET /api/mailbox/oauth/callback (a browser redirect with no Authorization
# header) can still prove which candidate it belongs to. See
# server/mailbox/oauthState.ts.
MAILBOX_OAUTH_STATE_SECRET=

# R6.1 — server-only, optional. Base origin the OAuth callback redirects
# the browser back to once it finishes, e.g. http://127.0.0.1:5174 for
# local dev (the Vite dev server's own port — Google's redirect lands
# directly on the Express server, bypassing Vite's proxy). Left unset in
# production: the server serves the built client from the same origin, so
# a relative redirect is already correct.
CLIENT_APP_URL=

# Task H1 billing — server-only, via the Stripe REST API. With neither of these
# configured, every billing route answers 503 "not configured" rather than
# failing open; nothing here invents a payment (server/billing/stripe.ts). The
# webhook secret is specifically required for POST /api/billing/webhook, which
# rejects unsigned requests by design: an unconfigured secret answers 503 rather
# than skipping verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Task H3 — server-only. 32 random bytes, base64-encoded (e.g. `openssl rand
# -base64 32`). Encrypts employer ATS credentials at rest before they are stored
# in ats_credentials. Deliberately SEPARATE from MAILBOX_TOKEN_ENCRYPTION_KEY,
# and the blast radii are why: a leaked mailbox token exposes one candidate's
# inbox, a leaked employer key can submit applications in that employer's name.
# Unset means the admin ATS Credentials screen answers 503.
ATS_CREDENTIAL_ENCRYPTION_KEY=

# Client variables are read by Vite via import.meta.env and must be
# prefixed with VITE_ to be exposed to browser code. Vite loads `.env`
# files automatically for `npm run dev:client` / `npm run build:client`,
# and Vitest (which runs through Vite) does the same for `npm test` —
# verified directly: a real .env here makes import.meta.env.VITE_* live
# inside test files too, not just app code.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
