# Placeholders only — no real values belong in this file (it is committed to git).
# Copy to `.env` for local development; `.env` is git-ignored.
#
# Server variables are read directly from process.env. tsx (used by `npm run
# dev:server`) does not auto-load `.env` files (verified: its README has no
# mention of env-file handling). Node >=20.6 supports the native
# `--env-file=.env` / `--env-file-if-exists=.env` flags if you want a local
# `.env` picked up automatically when running server code directly, e.g.:
#   node --env-file-if-exists=.env --import tsx server/index.ts
# No npm script currently wires this in; supply these variables via your
# shell environment, a process manager, or the flag above.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Service-role key — server/worker-only (ingestion writes to shared
# discovery data: vacancies, sources, etc.). Bypasses RLS. Never prefix
# this with VITE_ (that would expose it to the browser bundle) and never
# import server/supabaseServiceRole.ts from client/src.
SUPABASE_SERVICE_ROLE_KEY=

# R2 ingestion provider credentials — server/worker-only. Greenhouse and
# Lever discovery need no credentials at all (public GET endpoints).
# USAJOBS User-Agent must be the email address registered for the key, not
# a browser string. Not configured yet — no real values available this
# pass; the ingestion worker fails clearly rather than guessing if these
# are required but unset.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Client variables are read by Vite via import.meta.env and must be
# prefixed with VITE_ to be exposed to browser code. Vite loads `.env`
# files automatically for `npm run dev:client` / `npm run build:client`,
# and Vitest (which runs through Vite) does the same for `npm test` —
# verified directly: a real .env here makes import.meta.env.VITE_* live
# inside test files too, not just app code.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
